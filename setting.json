{
	"[scss]": {
		"editor.foldingStrategy": "indentation"
	},
	"better-comments.multilineComments": false,
	"better-comments.tags": [
		{
			"backgroundColor": "transparent",
			"bold": false,
			"color": "#FF2D00",
			"italic": false,
			"strikethrough": false,
			"tag": "!",
			"underline": false
		},
		{
			"backgroundColor": "transparent",
			"bold": false,
			"color": "#3498DB",
			"italic": false,
			"strikethrough": false,
			"tag": "?",
			"underline": false
		},
		{
			"backgroundColor": "transparent",
			"bold": false,
			"color": "#474747",
			"italic": false,
			"strikethrough": true,
			"tag": "//",
			"underline": false
		},
		{
			"backgroundColor": "transparent",
			"bold": false,
			"color": "#FF8C00",
			"italic": false,
			"strikethrough": false,
			"tag": "todo",
			"underline": false
		},
		{
			"backgroundColor": "transparent",
			"bold": false,
			"color": "#98C379",
			"italic": false,
			"strikethrough": false,
			"tag": "*",
			"underline": false
		}
	],
	"editor.smoothScrolling": true,
	"editor.fontSize": 14,
	"editor.codeActionsOnSave": {
		"source.addMissingImports": "false",
		"source.organizeImports": "false"
	},
	"editor.fontFamily": "'Source Code Pro', Menlo, Monaco, 'Courier New', monospace",
	"editor.fontLigatures": true,
	// "editor.formatOnPaste": true,
	// "editor.formatOnSave": true,
	"editor.guides.bracketPairs": "active",
	"editor.lineNumbers": "relative",
	"editor.linkedEditing": true,
	"editor.snippetSuggestions": "top",
	"editor.stickyScroll.enabled": true,
	"editor.suggest.insertMode": "replace",
	"editor.tabSize": 2,
	"editor.insertSpaces": true,
	"editor.detectIndentation": false,
	"extensions.autoUpdate": "onlyEnabledExtensions",
	"extensions.experimental.affinity": {
		"vscodevim.vim": 1
	},
	"liveServer.settings.donotShowInfoMsg": true,
	"liveServer.settings.donotVerifyTags": true,
	"prettier.jsxSingleQuote": true,
	"prettier.singleQuote": true,
	"prettier.useTabs": true,
	"reactSnippets.settings.languageScopes": "typescript,typescriptreact,javascript,javascriptreact,scss",
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.fontFamily": "Source Code Pro, MesloLGS NF, Menlo, Monaco, 'Courier New', monospace",
	"terminal.integrated.fontSize": 14,
	"terminal.integrated.defaultProfile.osx": "zsh",
	"todohighlight.keywords": [
		"DEBUG:",
		"REVIEW:",
		"INFO",
		{
			"backgroundColor": "yellow",
			"color": "#ff0000",
			"overviewRulerColor": "grey",
			"text": "NOTE:"
		},
		{
			"color": "#000",
			"isWholeLine": false,
			"text": "HACK:"
		},
		{
			"backgroundColor": "rgba(0,0,0,.2)",
			//other styling properties goes here ...
			"border": "1px solid red",
			"borderRadius": "2px", //NOTE: using borderRadius along with `border` or you will see nothing change
			"color": "red",
			"text": "TODO:"
		}
	],
	"typescript.preferences.importModuleSpecifier": "non-relative",
	"typescript.tsdk": "./node_modules/typescript/lib",
	"typescript.updateImportsOnFileMove.enabled": "always",
	//  vscode vim settings
	"vim.easymotion": true,
	"vim.useCtrlKeys": true,
	"vim.useSystemClipboard": true,
	// vscodevim appearance settings
	"editor.cursorSurroundingLines": 10,
	"vim.smartRelativeLine": true,
	// highlighted yank
	"vim.highlightedyank.enable": true,
	"vim.highlightedyank.color": "rgba(250, 97, 89, 0.7)",
	"vim.highlightedyank.textColor": "white",
	"vim.highlightedyank.duration": 150,
	// statusbar color
	"vim.statusBarColorControl": true,
	"vim.statusBarColors.normal": ["#005f5f", "#fff"],
	"vim.statusBarColors.insert": ["#5f0000", "#fff"],
	"vim.statusBarColors.visual": ["#5f00af", "#fff"],
	"vim.statusBarColors.visualline": ["#005f87", "#fff"],
	"vim.statusBarColors.visualblock": ["#86592d", "#fff"],
	"vim.statusBarColors.commandlineinprogress": ["#007acc", "#fff"],
	"vim.statusBarColors.searchinprogressmode": ["#007acc", "#fff"],
	"vim.statusBarColors.surroundinputmode": ["#007acc", "#fff"],
	"workbench.colorCustomizations": {
    "statusBar.background": "#005f87",
    "statusBar.noFolderBackground": "#005f87",
    "statusBar.debuggingBackground": "#005f87",
    "statusBar.foreground": "#fff",
    "statusBar.debuggingForeground": "#fff"
  },
	"vim.foldfix": true,
	"vim.handleKeys": {
		"<C-a>": false,
		"<C-d>": true,
		"<C-f>": false,
		"<C-h>": false,
		"<C-j>": false,
		"<C-k>": false
	},
	"vim.insertModeKeyBindings": [
		{
			"after": ["<Esc>"],
			"before": ["j", "j"]
		}
	],
	"vim.leader": "<space>",
	"vim.normalModeKeyBindings": [
		// -- General --
		{
			"before": ["<Esc>"],
			"commands": [":nohl"]
		},
		{
			"before": ["<leader>", "w"],
			"commands": ["workbench.action.files.save"]
		},
		{
			"before": ["<leader>", "q"],
			"commands": ["workbench.action.closeActiveEditor"]
		},
		{
			"before": ["<leader>", "f"],
			"commands": ["editor.action.formatDocument"]
		},
		{
			"before": ["<leader>", "t"],
			"commands": ["workbench.view.explorer"]
		},
		{
			"before": ["<leader>", "k"],
			"commands": ["lineBreakInsert"]
		},
		// -- Window split --
		{
			"before": ["|"],
			"after": ["<C-w>", "v"]
		},
		{
			"before": ["_"],
			"after": ["<C-w>", "s"]
		},
		// -- Tab navigation --
		{
			"before": ["<S-tab>"],
			"commands": ["workbench.action.previousEditor"]
		},
		{
			"before": ["<tab>"],
			"commands": ["workbench.action.nextEditor"]
		},
		// -- Search --
		{
			"before": ["<leader>", "/"],
			"commands": ["fuzzySearch.activeTextEditor"]
		},
		{
			"before": ["<leader>", "s", "f"],
			"commands": ["workbench.action.quickOpen"]
		},
		{
			"before": ["<leader>", "s", "g"],
			"commands": ["workbench.action.findInFiles"]
		},
		{
			"before": ["<leader>", "s", "p"],
			"commands": ["workbench.action.showCommands"]
		},
		{
			"before": ["<leader>", "s", "h"],
			"commands": ["vscode-harpoon.editorQuickPick"]
		},
		{
			"before": ["<leader>", "s", "."],
			"commands": ["workbench.action.openRecent"]
		},
		{
			"before": ["<leader>", "s", "k"],
			"commands": ["workbench.action.openGlobalKeybindings"]
		},
		{
			"before": ["<leader>", "s", "e"],
			"commands": ["workbench.view.extensions"]
		},
		{
			"before": ["<leader>", "d", "s"],
			"commands": ["workbench.action.gotoSymbol"]
		},
		// -- Harpoon --
		{
			"before": ["<leader>", "a"],
			"commands": ["vscode-harpoon.addEditor"]
		},
		{
			"before": ["<leader>", "e"],
			"commands": ["vscode-harpoon.editEditors"]
		},
		// -- LSP / Code --
		{
			"before": ["<leader>", "c", "a"],
			"commands": ["editor.action.quickFix"]
		},
		{
			"before": ["<leader>", "r", "n"],
			"commands": ["editor.action.rename"]
		},
		{
			"before": ["<leader>", "r", "c"],
			"commands": ["editor.action.refactor"]
		},
		{
			"before": ["<leader>", "D"],
			"commands": ["editor.action.goToTypeDefinition"]
		},
		// -- Run / Debug --
		{
			"before": ["<leader>", "r", "d"],
			"commands": ["workbench.action.debug.start"]
		},
		{
			"before": ["<leader>", "r", "r"],
			"commands": ["workbench.action.debug.run"]
		},
		// -- Git --
		{
			"before": ["<leader>", "g", "p"],
			"commands": ["editor.action.dirtydiff.next"]
		},
		{
			"before": ["<leader>", "g", "r"],
			"commands": ["git.revertSelectedRanges"]
		},
		{
			"before": ["<leader>", "g", "b"],
			"commands": ["gitlens.toggleLineBlame"]
		}
	],
	"vim.normalModeKeyBindingsNonRecursive": [
		{
			"before": ["<C-n>"],
			"after": [],
			"commands": [":nohl"]
		}
	],
	"vim.visualModeKeyBindings": [
		{
			"before": [">"],
			"commands": ["editor.action.indentLines"]
		},
		{
			"before": ["<"],
			"commands": ["editor.action.outdentLines"]
		},
		{
			"before": ["J"],
			"commands": ["editor.action.moveLinesDownAction"]
		},
		{
			"before": ["K"],
			"commands": ["editor.action.moveLinesUpAction"]
		},
		{
			"before": ["<leader>", "g", "r"],
			"commands": ["git.revertSelectedRanges"]
		}
	],
	"window.titleBarStyle": "custom",
	"workbench.settings.editor": "json",
	"zenMode.hideLineNumbers": false,
	"sortJSON.orderOverride": ["name", "version", "description", "scripts"],
	"sortJSON.orderUnderride": ["dependencies", "devDependencies"],
	"editor.renderWhitespace": "boundary",
	"emmet.includeLanguages": {
		"javascript": "javascriptreact"
	},
	"emmet.syntaxProfiles": {
		"javascript": "jsx"
	},
	"javascript.updateImportsOnFileMove.enabled": "always",
	"workbench.colorTheme": "gruvboxConcoctis dark hard",
	"git.openRepositoryInParentFolders": "always",
  "vim.autoSwitchInputMethod.enable": true,
  "vim.autoSwitchInputMethod.defaultIM": "com.apple.keylayout.ABC",
  "vim.autoSwitchInputMethod.obtainIMCmd": "/opt/homebrew/bin/im-select",
  "vim.autoSwitchInputMethod.switchIMCmd": "/opt/homebrew/bin/im-select {im}",
	"vim.searchHighlightColor": "red",
	"workbench.activityBar.location": "top",
	"update.mode": "manual",
	"diffEditor.ignoreTrimWhitespace": false,
	"workbench.sideBar.location": "right",
	"workbench.editor.showTabs": "multiple",
	"window.commandCenter": false,
	"window.restoreWindows": "none",
	"zenMode.centerLayout": false,
	"workbench.startupEditor": "none",
	"files.hotExit": "off",
	"workbench.tips.enabled": false,
	"editor.wordWrap": "on",
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"security.workspace.trust.untrustedFiles": "open",
	"claudeCode.preferredLocation": "panel",
	"editor.cursorBlinking": "blink",
	"editor.columnSelection": true
}
